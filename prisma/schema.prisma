generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  DROPDOWN
  RADIO
  CHECKBOX
  DATE
  TEXTAREA
  CONSENT
  NUMBER
  URL
  HIDDEN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  LOGIN
  LOGOUT
  SUBMIT
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String
  role          UserRole   @default(EDITOR)
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auditLogs     AuditLog[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  logoUrl     String?
  primaryColor String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  domains     Domain[]
  campaigns   Campaign[]
  forms       Form[]
}

model Domain {
  id        String   @id @default(cuid())
  brandId   String
  domain    String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  slug        String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  forms       Form[]

  @@unique([brandId, slug])
}

model Form {
  id           String        @id @default(cuid())
  brandId      String
  campaignId   String?
  title        String
  slug         String
  description  String?
  status       FormStatus    @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  versions     FormVersion[]
  submissions  Submission[]
  mediaAssets  MediaAsset[]

  @@unique([brandId, slug])
}

model FormVersion {
  id            String     @id @default(cuid())
  formId        String
  version       Int
  status        FormStatus @default(DRAFT)
  schema        Json
  ctaText       String?
  thankYouTitle String?
  thankYouBody  String?
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  form          Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields        Field[]
  submissions   Submission[]

  @@unique([formId, version])
}

model Field {
  id            String      @id @default(cuid())
  formVersionId String
  type          FieldType
  name          String
  label         String
  placeholder   String?
  helpText      String?
  required      Boolean     @default(false)
  order         Int
  options       Json?
  validation    Json?
  defaultValue  String?
  hidden        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id          String   @id @default(cuid())
  formId      String?
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  createdAt   DateTime @default(now())
  form        Form?    @relation(fields: [formId], references: [id])
}

model Submission {
  id            String          @id @default(cuid())
  formId        String
  formVersionId String
  data          Json
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  ipAddress     String?
  userAgent     String?
  referrer      String?
  createdAt     DateTime        @default(now())
  form          Form            @relation(fields: [formId], references: [id])
  formVersion   FormVersion     @relation(fields: [formVersionId], references: [id])
  consentRecords ConsentRecord[]
}

model ConsentRecord {
  id           String     @id @default(cuid())
  submissionId String
  fieldName    String
  consentText  String
  accepted     Boolean
  timestamp    DateTime   @default(now())
  ipAddress    String?
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])
}
